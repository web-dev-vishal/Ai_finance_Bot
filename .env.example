# ── Groq AI ──────────────────────────────────────────────────────────────────
# Get your free API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Model to use (llama-3.3-70b-versatile is recommended)
GROQ_MODEL=llama-3.3-70b-versatile

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local MongoDB (default)
MONGO_URI=mongodb://localhost:27017/financeBot

# MongoDB Atlas (cloud) example:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/financeBot?retryWrites=true&w=majority

DB_NAME=financeBot
